<Window x:Class="DEM_1Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DEM_1Project"
        mc:Ignorable="d"
        Title="Вход в систему" 
        Height="300" Width="350" 
        WindowStartupLocation="CenterScreen" 
        Icon="/Assets/app.ico">
    <!-- путь к иконке через Assets -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Логотип из папки Assets -->
        <Image Grid.Row="0" 
               Source="/Assets/logo.png"
               Width="64" Height="64" 
               HorizontalAlignment="Center" Margin="5"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Логин:" Margin="5"/>
            <TextBox x:Name="txtLogin" Grid.Row="1" Grid.Column="1" Margin="5"/>

            <Label Grid.Row="2" Grid.Column="0" Content="Пароль:" Margin="5"/>
            <PasswordBox x:Name="txtPassword" Grid.Row="2" Grid.Column="1" Margin="5"/>

            <Button x:Name="btnLogin" 
                Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" 
                Content="Войти" Margin="5" 
                Click="btnLogin_Click"/>

            <Button x:Name="btnGuest" 
                Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" 
                Content="Войти как гость" Margin="5" 
                Click="btnGuest_Click"/>
    </Grid>
</Window>